# Kopeeri see fail nimega .env ja täida väärtused. .env EI lähe git'i!

# Postgresi parool (genereeri: openssl rand -base64 24)
POSTGRES_PASSWORD=muuda-mind

# Google Gemini API võti (AI funktsioonid; ilma selleta backend ei käivitu)
GOOGLE_AI_API_KEY=muuda-mind

# Aadress, millel Caddy teenindab:
# - lokaalselt:  http://localhost  (http-prefiks lülitab HTTPS-i välja)
# - serveris:    <IP-sidekriipsudega>.sslip.io  (nt 91-98-82-87.sslip.io)
SITE_ADDRESS=http://localhost

# Host-masina pordid (vaikimisi 80/443; muuda, kui lokaalselt on port 80 hõivatud)
#HTTP_PORT=8090
#HTTPS_PORT=8443

# Postgresi port host-masina localhost'il (DB-tööriistade jaoks; väljast ligipääsu ei ole)
#DB_PORT=5433
